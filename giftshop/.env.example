# Everything about the site's content (name, tagline, products, prices, contact, tracking IDs) is edited in /admin.
# These are only the secrets / infrastructure settings, set in Vercel > Project > Settings > Environment Variables.

# Admin panel password (required in production)
ADMIN_PASSWORD=

# Postgres database (Neon via Vercel Marketplace, or Supabase). Without it, edits are temporary.
DATABASE_URL=

# Online payments (Razorpay). Without keys checkout runs in demo mode; COD still works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: e-mail alerts to you for new orders / enquiries (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=you@yourcompany.com
# MAIL_FROM="HML Gifting <orders@yourdomain.com>"   (needs a verified domain in Resend)

# Your live website address (used in sitemap, SEO and the product feed)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
