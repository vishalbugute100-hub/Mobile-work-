# ---- Branding / SEO ----
NEXT_PUBLIC_STORE_NAME=Giftora
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP=919999999999

# ---- Database (Neon / Supabase / any Postgres). Without it, orders go to a temp file (demo only) ----
DATABASE_URL=

# ---- Payments: Razorpay. Without keys the checkout runs in demo mode ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_ENABLED=false

# ---- Admin panel (/admin). Required in production ----
ADMIN_PASSWORD=

# ---- Marketing / SEM tracking (optional) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
